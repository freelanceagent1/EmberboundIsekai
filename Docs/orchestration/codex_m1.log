+
+	DECLARE_DELEGATE(FOnPortalEntered);
+	FOnPortalEntered OnPortalEntered;
+
+private:
+	UPROPERTY(VisibleAnywhere)
+	TObjectPtr<USphereComponent> Collision;
+
+	UPROPERTY(VisibleAnywhere)
