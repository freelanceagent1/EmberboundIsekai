diff --git a/Source/EmberboundIsekai/Combat/XPComponent.cpp b/Source/EmberboundIsekai/Combat/XPComponent.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..66ff998fe995b59667ecb41480bd91b94504425c
--- /dev/null
+++ b/Source/EmberboundIsekai/Combat/XPComponent.cpp
@@ -0,0 +1,29 @@
+#include "Combat/XPComponent.h"
+#include "Combat/HealthComponent.h"
+#include "EmberboundIsekai.h"
+
+UXPComponent::UXPComponent()
+{
+	PrimaryComponentTick.bCanEverTick = false;
+}
+
+void UXPComponent::AddXP(int32 Amount)
+{
+	XP += FMath::Max(0, Amount);
+	while (XP >= GetXPToNext())
+	{
+		XP -= GetXPToNext();
+		++Level;
+		if (UHealthComponent* Health = GetOwner()->FindComponentByClass<UHealthComponent>())
+		{
+			Health->Heal(10.0f);
+		}
+		UE_LOG(LogEmberbound, Log, TEXT("EMBER: LevelUp Level=%d"), Level);
+		OnLevelUp.Broadcast(Level);
+	}
+}
+
+int32 UXPComponent::GetXPToNext() const
+{
+	return FMath::Max(1, FMath::RoundToInt(10.0f * FMath::Pow(1.35f, static_cast<float>(Level - 1))));
+}
diff --git a/Source/EmberboundIsekai/Combat/XPComponent.h b/Source/EmberboundIsekai/Combat/XPComponent.h
new file mode 100644
index 0000000000000000000000000000000000000000..ce36ea5d90d3c0a57880ad810cf5f7b98c370753
--- /dev/null
+++ b/Source/EmberboundIsekai/Combat/XPComponent.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Components/ActorComponent.h"
+#include "XPComponent.generated.h"
+
+DECLARE_DYNAMIC_MULTICAST_DELEGATE_OneParam(FOnEmberLevelUp, int32, NewLevel);
+
+UCLASS(ClassGroup = (Combat), meta = (BlueprintSpawnableComponent))
+class EMBERBOUNDISEKAI_API UXPComponent : public UActorComponent
+{
+	GENERATED_BODY()
