+missing = [path for path in required if not unreal.EditorAssetLibrary.does_asset_exist(path)]
+if missing:
+    raise RuntimeError("Missing required M1 assets: " + ", ".join(missing))
+
+print("M1_ASSET_VERIFY_OK")

