+import unreal
+
+required = [
+    "/Game/Emberbound/Maps/Expedition/L_Expedition",
+    "/Game/Emberbound/Materials/Stylized/M_Enemy",
+    "/Game/Emberbound/Materials/Stylized/M_Floor",
