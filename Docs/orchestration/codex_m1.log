new file mode 100644
index 0000000000000000000000000000000000000000..ee73a17194811138074420c6374b4bc5a23da406
--- /dev/null
+++ b/Source/EmberboundIsekai/Core/EmberGameInstance.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include "CoreMinimal.h"
