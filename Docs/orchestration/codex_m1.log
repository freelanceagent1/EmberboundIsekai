+import unreal
+
+for cls_name in ["EditorLoadingAndSavingUtils", "LevelEditorSubsystem", "EditorActorSubsystem"]:
+    cls = getattr(unreal, cls_name)
+    print(cls_name)
+    print([name for name in dir(cls) if "level" in name.lower() or "map" in name.lower() or "save" in name.lower() or "spawn" in name.lower()])
diff --git a/Tools/EditorScripts/verify_m1_content.py b/Tools/EditorScripts/verify_m1_content.py
new file mode 100644
index 0000000000000000000000000000000000000000..6e8851fc1b816f760e72a35878cd379dd81ade0e
--- /dev/null
+++ b/Tools/EditorScripts/verify_m1_content.py
@@ -0,0 +1,19 @@
+import unreal
+
