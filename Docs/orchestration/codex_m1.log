diff --git a/Source/EmberboundIsekai/Combat/AutoAttackComponent.cpp b/Source/EmberboundIsekai/Combat/AutoAttackComponent.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..81ed9f681b87bae6a80363073bd11f0011e8a772
--- /dev/null
+++ b/Source/EmberboundIsekai/Combat/AutoAttackComponent.cpp
@@ -0,0 +1,86 @@
+#include "Combat/AutoAttackComponent.h"
+#include "Combat/EmberProjectile.h"
+#include "Combat/HealthComponent.h"
+#include "Core/ObjectPoolSubsystem.h"
+#include "Enemies/EmberEnemyBase.h"
+#include "Enemies/EnemySpawnerSubsystem.h"
+#include "EmberboundIsekai.h"
+#include "TimerManager.h"
+
+UAutoAttackComponent::UAutoAttackComponent()
+{
+	PrimaryComponentTick.bCanEverTick = false;
+}
+
+void UAutoAttackComponent::BeginPlay()
+{
+	Super::BeginPlay();
+	if (UWorld* World = GetWorld())
+	{
+		World->GetTimerManager().SetTimer(AcquisitionTimerHandle, this, &UAutoAttackComponent::AcquireTarget, 0.15f, true);
+		World->GetTimerManager().SetTimer(FireTimerHandle, this, &UAutoAttackComponent::FireAtTarget, AttackInterval, true, 0.25f);
+	}
+}
+
+void UAutoAttackComponent::EndPlay(const EEndPlayReason::Type EndPlayReason)
+{
+	if (UWorld* World = GetWorld())
+	{
+		World->GetTimerManager().ClearTimer(AcquisitionTimerHandle);
+		World->GetTimerManager().ClearTimer(FireTimerHandle);
+	}
+	Super::EndPlay(EndPlayReason);
+}
+
+void UAutoAttackComponent::AcquireTarget()
+{
+	CurrentTarget = nullptr;
+	AActor* Owner = GetOwner();
+	UWorld* World = GetWorld();
+	if (!Owner || !World)
+	{
+		return;
+	}
+	UEnemySpawnerSubsystem* SpawnerSubsystem = World->GetSubsystem<UEnemySpawnerSubsystem>();
+	if (!SpawnerSubsystem)
+	{
+		return;
+	}
+
+	float BestDistanceSq = FMath::Square(Range);
+	for (AEmberEnemyBase* Enemy : SpawnerSubsystem->GetLiveEnemies())
+	{
+		if (!Enemy || !Enemy->IsAlive())
+		{
+			continue;
+		}
+		const float DistanceSq = FVector::DistSquared2D(Owner->GetActorLocation(), Enemy->GetActorLocation());
+		if (DistanceSq <= BestDistanceSq)
+		{
+			BestDistanceSq = DistanceSq;
+			CurrentTarget = Enemy;
+		}
+	}
+}
+
+void UAutoAttackComponent::FireAtTarget()
+{
+	AActor* Owner = GetOwner();
+	if (!Owner || !CurrentTarget || !CurrentTarget->IsAlive() || !GetWorld())
+	{
+		return;
+	}
+	const FVector Direction = (CurrentTarget->GetActorLocation() - Owner->GetActorLocation()).GetSafeNormal2D();
+	UObjectPoolSubsystem* Pool = GetWorld()->GetSubsystem<UObjectPoolSubsystem>();
+	if (!Pool)
+	{
+		return;
+	}
+	const FVector SpawnLocation = Owner->GetActorLocation() + Direction * 70.0f + FVector(0.0f, 0.0f, 45.0f);
+	if (AEmberProjectile* Projectile = Pool->Acquire<AEmberProjectile>(AEmberProjectile::StaticClass(), FTransform(Direction.Rotation(), SpawnLocation)))
+	{
+		const bool bCrit = FMath::FRand() < CritChance;
+		Projectile->Fire(Direction, bCrit ? Damage * CritMultiplier : Damage, ProjectileSpeed, PierceCount, Owner, false);
+		UE_LOG(LogEmberbound, Log, TEXT("EMBER: ProjectileFired"));
+	}
+}
diff --git a/Source/EmberboundIsekai/Combat/AutoAttackComponent.h b/Source/EmberboundIsekai/Combat/AutoAttackComponent.h
new file mode 100644
index 0000000000000000000000000000000000000000..f428f52e84aa00f2919f9aa965a4603b49576044
--- /dev/null
+++ b/Source/EmberboundIsekai/Combat/AutoAttackComponent.h
@@ -0,0 +1,56 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Components/ActorComponent.h"
+#include "AutoAttackComponent.generated.h"
+
+class AEmberEnemyBase;
+
+UCLASS(ClassGroup = (Combat), meta = (BlueprintSpawnableComponent))
+class EMBERBOUNDISEKAI_API UAutoAttackComponent : public UActorComponent
+{
+	GENERATED_BODY()
+
+public:
+	UAutoAttackComponent();
+
+	virtual void BeginPlay() override;
+	virtual void EndPlay(const EEndPlayReason::Type EndPlayReason) override;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Attack")
+	float Damage = 12.0f;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Attack")
+	float AttackInterval = 0.7f;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Attack")
+	float Range = 900.0f;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Attack")
+	float ProjectileSpeed = 1600.0f;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Attack")
+	float CritChance = 0.05f;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Attack")
+	float CritMultiplier = 2.0f;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Upgrades")
+	int32 PierceCount = 0;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Upgrades")
+	int32 SplitCount = 0;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Upgrades")
+	int32 RicochetCount = 0;
+
+private:
+	FTimerHandle AcquisitionTimerHandle;
+	FTimerHandle FireTimerHandle;
+
+	UPROPERTY()
+	TObjectPtr<AEmberEnemyBase> CurrentTarget;
+
+	void AcquireTarget();
+	void FireAtTarget();
+};
diff --git a/Source/EmberboundIsekai/Combat/EmberPickup.cpp b/Source/EmberboundIsekai/Combat/EmberPickup.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..792907f3d80ab52ead4b5b0b372ce86c82ab7b97
--- /dev/null
+++ b/Source/EmberboundIsekai/Combat/EmberPickup.cpp
@@ -0,0 +1,95 @@
+#include "Combat/EmberPickup.h"
+#include "Combat/EmberPlayerCharacter.h"
+#include "Combat/XPComponent.h"
+#include "Core/EconomySubsystem.h"
+#include "Core/ObjectPoolSubsystem.h"
+#include "Components/SphereComponent.h"
+#include "Components/StaticMeshComponent.h"
+#include "Engine/StaticMesh.h"
+#include "Kismet/GameplayStatics.h"
+
+AEmberPickup::AEmberPickup()
+{
+	PrimaryActorTick.bCanEverTick = true;
+	Collision = CreateDefaultSubobject<USphereComponent>(TEXT("Collision"));
+	SetRootComponent(Collision);
+	Collision->InitSphereRadius(28.0f);
+	Collision->SetCollisionProfileName(TEXT("OverlapAllDynamic"));
+	Collision->OnComponentBeginOverlap.AddDynamic(this, &AEmberPickup::HandleOverlap);
+
+	Visual = CreateDefaultSubobject<UStaticMeshComponent>(TEXT("Visual"));
+	Visual->SetupAttachment(RootComponent);
+	Visual->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+	static ConstructorHelpers::FObjectFinder<UStaticMesh> SphereMesh(TEXT("/Engine/BasicShapes/Sphere.Sphere"));
+	if (SphereMesh.Succeeded())
+	{
+		Visual->SetStaticMesh(SphereMesh.Object);
+		Visual->SetRelativeScale3D(FVector(0.12f));
+	}
+}
+
+void AEmberPickup::Tick(float DeltaSeconds)
+{
+	Super::Tick(DeltaSeconds);
+	AEmberPlayerCharacter* Player = Cast<AEmberPlayerCharacter>(UGameplayStatics::GetPlayerCharacter(this, 0));
+	if (!Player)
+	{
+		return;
+	}
+	const float Distance = FVector::Dist2D(GetActorLocation(), Player->GetActorLocation());
+	if (Distance <= Player->GetPickupRadius())
+	{
+		const FVector NewLocation = FMath::VInterpTo(GetActorLocation(), Player->GetActorLocation(), DeltaSeconds, 8.0f);
+		SetActorLocation(NewLocation);
+	}
+}
+
+void AEmberPickup::OnReleased_Implementation()
+{
+	Amount = 1;
+}
+
+void AEmberPickup::Configure(EEmberPickupType InType, int32 InAmount)
+{
+	PickupType = InType;
+	Amount = FMath::Max(1, InAmount);
+}
+
+void AEmberPickup::HandleOverlap(UPrimitiveComponent*, AActor* OtherActor, UPrimitiveComponent*, int32, bool, const FHitResult&)
+{
+	if (AEmberPlayerCharacter* Player = Cast<AEmberPlayerCharacter>(OtherActor))
+	{
+		Collect(Player);
+	}
+}
+
+void AEmberPickup::Collect(AEmberPlayerCharacter* Player)
+{
+	if (!Player)
+	{
+		return;
+	}
+	if (PickupType == EEmberPickupType::XP)
+	{
+		if (UXPComponent* XPComponent = Player->FindComponentByClass<UXPComponent>())
+		{
+			XPComponent->AddXP(Amount);
+		}
+	}
+	else if (UGameInstance* GameInstance = GetGameInstance())
+	{
+		if (UEconomySubsystem* Economy = GameInstance->GetSubsystem<UEconomySubsystem>())
+		{
+			const EEmberResource Resource = PickupType == EEmberPickupType::Wood ? EEmberResource::Wood : PickupType == EEmberPickupType::SoulAsh ? EEmberResource::SoulAsh : EEmberResource::Gold;
+			Economy->Add(Resource, Amount);
+		}
+	}
+	if (UObjectPoolSubsystem* Pool = GetWorld()->GetSubsystem<UObjectPoolSubsystem>())
+	{
+		Pool->ReleaseActor(this);
+	}
+	else
+	{
+		Destroy();
+	}
+}
diff --git a/Source/EmberboundIsekai/Combat/EmberPickup.h b/Source/EmberboundIsekai/Combat/EmberPickup.h
new file mode 100644
index 0000000000000000000000000000000000000000..ea698a148e8d6dc70270c490c8e34051696bda82
--- /dev/null
+++ b/Source/EmberboundIsekai/Combat/EmberPickup.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "GameFramework/Actor.h"
+#include "Core/Poolable.h"
+#include "Data/ResourceTypes.h"
+#include "EmberPickup.generated.h"
+
+class USphereComponent;
+class UStaticMeshComponent;
+class AEmberPlayerCharacter;
+
+UENUM(BlueprintType)
+enum class EEmberPickupType : uint8
+{
+	XP,
+	Gold,
+	Wood,
+	SoulAsh
+};
+
+UCLASS()
+class EMBERBOUNDISEKAI_API AEmberPickup : public AActor, public IPoolable
+{
+	GENERATED_BODY()
+
+public:
+	AEmberPickup();
+
+	virtual void Tick(float DeltaSeconds) override;
+	virtual void OnReleased_Implementation() override;
+
+	void Configure(EEmberPickupType InType, int32 InAmount);
+
+private:
+	UPROPERTY(VisibleAnywhere)
+	TObjectPtr<USphereComponent> Collision;
+
+	UPROPERTY(VisibleAnywhere)
+	TObjectPtr<UStaticMeshComponent> Visual;
+
+	UPROPERTY()
+	EEmberPickupType PickupType = EEmberPickupType::XP;
+
+	UPROPERTY()
+	int32 Amount = 1;
+
+	UFUNCTION()
+	void HandleOverlap(UPrimitiveComponent* OverlappedComponent, AActor* OtherActor, UPrimitiveComponent* OtherComp, int32 OtherBodyIndex, bool bFromSweep, const FHitResult& SweepResult);
+
+	void Collect(AEmberPlayerCharacter* Player);
+};
diff --git a/Source/EmberboundIsekai/Combat/EmberPlayerCharacter.cpp b/Source/EmberboundIsekai/Combat/EmberPlayerCharacter.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ec71dd8ff4b879acd161a5225e06188430d25643
--- /dev/null
+++ b/Source/EmberboundIsekai/Combat/EmberPlayerCharacter.cpp
@@ -0,0 +1,111 @@
+#include "Combat/EmberPlayerCharacter.h"
+#include "Combat/AutoAttackComponent.h"
+#include "Combat/HealthComponent.h"
+#include "Combat/XPComponent.h"
+#include "Camera/CameraComponent.h"
+#include "Components/CapsuleComponent.h"
+#include "EnhancedInputComponent.h"
+#include "EnhancedInputSubsystems.h"
+#include "GameFramework/CharacterMovementComponent.h"
+#include "GameFramework/SpringArmComponent.h"
+#include "InputAction.h"
+#include "InputMappingContext.h"
+#include "InputModifiers.h"
+#include "EmberboundIsekai.h"
+
+AEmberPlayerCharacter::AEmberPlayerCharacter()
+{
+	PrimaryActorTick.bCanEverTick = false;
+
+	GetCapsuleComponent()->InitCapsuleSize(42.0f, 96.0f);
+	GetCharacterMovement()->MaxWalkSpeed = 450.0f;
+	GetCharacterMovement()->bOrientRotationToMovement = true;
+	bUseControllerRotationYaw = false;
+
+	SpringArm = CreateDefaultSubobject<USpringArmComponent>(TEXT("SpringArm"));
+	SpringArm->SetupAttachment(RootComponent);
+	SpringArm->TargetArmLength = 1400.0f;
+	SpringArm->SetRelativeRotation(FRotator(-55.0f, 0.0f, 0.0f));
+	SpringArm->bUsePawnControlRotation = false;
+	SpringArm->bEnableCameraRotationLag = false;
+	SpringArm->bEnableCameraLag = false;
+
+	Camera = CreateDefaultSubobject<UCameraComponent>(TEXT("Camera"));
+	Camera->SetupAttachment(SpringArm);
+	Camera->bUsePawnControlRotation = false;
+
+	HealthComponent = CreateDefaultSubobject<UHealthComponent>(TEXT("HealthComponent"));
+	HealthComponent->MaxHP = 100.0f;
+	XPComponent = CreateDefaultSubobject<UXPComponent>(TEXT("XPComponent"));
+	AutoAttackComponent = CreateDefaultSubobject<UAutoAttackComponent>(TEXT("AutoAttackComponent"));
+}
+
+void AEmberPlayerCharacter::BeginPlay()
+{
+	Super::BeginPlay();
+	BuildRuntimeInput();
+	UE_LOG(LogEmberbound, Log, TEXT("EMBER: PlayerSpawned"));
+}
+
+void AEmberPlayerCharacter::SetupPlayerInputComponent(UInputComponent* PlayerInputComponent)
+{
+	Super::SetupPlayerInputComponent(PlayerInputComponent);
+	if (UEnhancedInputComponent* EnhancedInput = Cast<UEnhancedInputComponent>(PlayerInputComponent))
+	{
+		if (!MoveAction)
+		{
+			BuildRuntimeInput();
+		}
+		EnhancedInput->BindAction(MoveAction, ETriggerEvent::Triggered, this, &AEmberPlayerCharacter::Move);
+	}
+}
+
+void AEmberPlayerCharacter::Move(const FInputActionValue& Value)
+{
+	const FVector2D Movement = Value.Get<FVector2D>();
+	if (!Movement.IsNearlyZero())
+	{
+		AddMovementInput(FVector::ForwardVector, Movement.Y);
+		AddMovementInput(FVector::RightVector, Movement.X);
+	}
+}
+
+void AEmberPlayerCharacter::BuildRuntimeInput()
+{
+	if (!MoveAction)
+	{
+		MoveAction = NewObject<UInputAction>(this, TEXT("IA_RuntimeMove"));
+		MoveAction->ValueType = EInputActionValueType::Axis2D;
+	}
+	if (!MappingContext)
+	{
+		MappingContext = NewObject<UInputMappingContext>(this, TEXT("IMC_RuntimeMove"));
+		UInputModifierSwizzleAxis* SwizzleYXZ = NewObject<UInputModifierSwizzleAxis>(MappingContext);
+		SwizzleYXZ->Order = EInputAxisSwizzle::YXZ;
+		UInputModifierNegate* Negate = NewObject<UInputModifierNegate>(MappingContext);
+		Negate->bX = true;
+		Negate->bY = true;
+		Negate->bZ = false;
+		UInputModifierNegate* NegateX = NewObject<UInputModifierNegate>(MappingContext);
+		NegateX->bX = true;
+		NegateX->bY = false;
+		NegateX->bZ = false;
+
+		MappingContext->MapKey(MoveAction, EKeys::W).Modifiers.Add(SwizzleYXZ);
+		MappingContext->MapKey(MoveAction, EKeys::S).Modifiers.Append({ SwizzleYXZ, Negate });
+		MappingContext->MapKey(MoveAction, EKeys::D);
+		MappingContext->MapKey(MoveAction, EKeys::A).Modifiers.Add(NegateX);
+		MappingContext->MapKey(MoveAction, EKeys::Gamepad_Left2D);
+	}
+
+	if (APlayerController* PC = Cast<APlayerController>(GetController()))
+	{
+		if (ULocalPlayer* LocalPlayer = PC->GetLocalPlayer())
+		{
+			if (UEnhancedInputLocalPlayerSubsystem* Subsystem = LocalPlayer->GetSubsystem<UEnhancedInputLocalPlayerSubsystem>())
+			{
+				Subsystem->AddMappingContext(MappingContext, 0);
+			}
+		}
+	}
+}
diff --git a/Source/EmberboundIsekai/Combat/EmberPlayerCharacter.h b/Source/EmberboundIsekai/Combat/EmberPlayerCharacter.h
new file mode 100644
index 0000000000000000000000000000000000000000..ed2b1339a07f5cce8d3d2bdc6bf62069bd8715b7
