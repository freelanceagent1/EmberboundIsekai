diff --git a/Source/EmberboundIsekai/Core/ObjectPoolSubsystem.cpp b/Source/EmberboundIsekai/Core/ObjectPoolSubsystem.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9ad112b5124047a6229fbad7f0de41c70c2373ca
--- /dev/null
+++ b/Source/EmberboundIsekai/Core/ObjectPoolSubsystem.cpp
@@ -0,0 +1,51 @@
+#include "Core/ObjectPoolSubsystem.h"
+#include "Core/Poolable.h"
+
+AActor* UObjectPoolSubsystem::AcquireActor(TSubclassOf<AActor> ActorClass, const FTransform& Transform)
+{
+	if (!GetWorld() || !*ActorClass)
+	{
+		return nullptr;
+	}
+
+	AActor* Actor = nullptr;
+	TArray<TObjectPtr<AActor>>& Actors = Pool.FindOrAdd(ActorClass);
+	while (Actors.Num() > 0 && !Actor)
+	{
+		Actor = Actors.Pop();
+	}
+
+	if (!Actor)
+	{
+		Actor = GetWorld()->SpawnActor<AActor>(ActorClass, Transform);
+	}
+	else
+	{
+		Actor->SetActorTransform(Transform);
+		Actor->SetActorHiddenInGame(false);
+		Actor->SetActorEnableCollision(true);
+		Actor->SetActorTickEnabled(true);
+	}
+
+	if (Actor && Actor->GetClass()->ImplementsInterface(UPoolable::StaticClass()))
+	{
+		IPoolable::Execute_OnAcquired(Actor);
+	}
+	return Actor;
+}
+
+void UObjectPoolSubsystem::ReleaseActor(AActor* Actor)
+{
+	if (!Actor)
+	{
+		return;
+	}
+	if (Actor->GetClass()->ImplementsInterface(UPoolable::StaticClass()))
+	{
+		IPoolable::Execute_OnReleased(Actor);
+	}
+	Actor->SetActorHiddenInGame(true);
+	Actor->SetActorEnableCollision(false);
+	Actor->SetActorTickEnabled(false);
+	Pool.FindOrAdd(Actor->GetClass()).Add(Actor);
+}
diff --git a/Source/EmberboundIsekai/Core/ObjectPoolSubsystem.h b/Source/EmberboundIsekai/Core/ObjectPoolSubsystem.h
new file mode 100644
