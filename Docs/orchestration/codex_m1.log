+#include "Core/Poolable.h"
+#include "Data/EmberEnemyData.h"
+#include "EmberEnemyBase.generated.h"
+
+class AEmberPlayerCharacter;
+class UFloatingPawnMovement;
+class UHealthComponent;
+class ULootDropComponent;
+class USphereComponent;
+class UStaticMeshComponent;
+
+UCLASS()
+class EMBERBOUNDISEKAI_API AEmberEnemyBase : public APawn, public IPoolable
+{
+	GENERATED_BODY()
+
+public:
+	AEmberEnemyBase();
+
+	virtual void BeginPlay() override;
+	virtual void EndPlay(const EEndPlayReason::Type EndPlayReason) override;
+	virtual void Tick(float DeltaSeconds) override;
+	virtual void OnAcquired_Implementation() override;
+	virtual void OnReleased_Implementation() override;
+
+	void InitFromData(UEmberEnemyData* InEnemyData);
+	bool IsAlive() const;
+
+private:
+	UPROPERTY(VisibleAnywhere)
+	TObjectPtr<USphereComponent> Collision;
+
+	UPROPERTY(VisibleAnywhere)
+	TObjectPtr<UStaticMeshComponent> Visual;
+
+	UPROPERTY(VisibleAnywhere)
+	TObjectPtr<UFloatingPawnMovement> Movement;
+
+	UPROPERTY(VisibleAnywhere)
+	TObjectPtr<UHealthComponent> HealthComponent;
+
+	UPROPERTY(VisibleAnywhere)
+	TObjectPtr<ULootDropComponent> LootDropComponent;
+
+	UPROPERTY()
+	TObjectPtr<UEmberEnemyData> EnemyData;
+
+	UPROPERTY()
+	TObjectPtr<AEmberPlayerCharacter> Player;
+
+	FTimerHandle RepathTimerHandle;
+	FTimerHandle RangedTimerHandle;
+	TMap<TWeakObjectPtr<AActor>, float> ContactCooldowns;
+	FVector DesiredDirection = FVector::ZeroVector;
+
+	void UpdateDesiredDirection();
+	void FireRangedProjectile();
+
+	UFUNCTION()
+	void HandleOverlap(UPrimitiveComponent* OverlappedComponent, AActor* OtherActor, UPrimitiveComponent* OtherComp, int32 OtherBodyIndex, bool bFromSweep, const FHitResult& SweepResult);
+
+	UFUNCTION()
+	void HandleDeath(AActor* DeadActor);
+};
diff --git a/Source/EmberboundIsekai/Enemies/EnemySpawnerSubsystem.cpp b/Source/EmberboundIsekai/Enemies/EnemySpawnerSubsystem.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..026c2adab405a59f2606d7acd4deeb6b842e473e
--- /dev/null
+++ b/Source/EmberboundIsekai/Enemies/EnemySpawnerSubsystem.cpp
@@ -0,0 +1,15 @@
+#include "Enemies/EnemySpawnerSubsystem.h"
+#include "Enemies/EmberEnemyBase.h"
+
+void UEnemySpawnerSubsystem::RegisterEnemy(AEmberEnemyBase* Enemy)
+{
+	if (Enemy)
+	{
+		LiveEnemies.AddUnique(Enemy);
+	}
+}
+
+void UEnemySpawnerSubsystem::UnregisterEnemy(AEmberEnemyBase* Enemy)
+{
+	LiveEnemies.Remove(Enemy);
+}
diff --git a/Source/EmberboundIsekai/Enemies/EnemySpawnerSubsystem.h b/Source/EmberboundIsekai/Enemies/EnemySpawnerSubsystem.h
new file mode 100644
index 0000000000000000000000000000000000000000..4b8ec25472c1593811b44d43dda56ca7a02cefeb
--- /dev/null
+++ b/Source/EmberboundIsekai/Enemies/EnemySpawnerSubsystem.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Subsystems/WorldSubsystem.h"
+#include "EnemySpawnerSubsystem.generated.h"
+
+class AEmberEnemyBase;
+
+UCLASS()
+class EMBERBOUNDISEKAI_API UEnemySpawnerSubsystem : public UWorldSubsystem
+{
+	GENERATED_BODY()
+
+public:
+	void RegisterEnemy(AEmberEnemyBase* Enemy);
+	void UnregisterEnemy(AEmberEnemyBase* Enemy);
+
+	const TArray<TObjectPtr<AEmberEnemyBase>>& GetLiveEnemies() const { return LiveEnemies; }
+	int32 GetLiveEnemyCount() const { return LiveEnemies.Num(); }
+
+private:
+	UPROPERTY()
+	TArray<TObjectPtr<AEmberEnemyBase>> LiveEnemies;
+};
diff --git a/Source/EmberboundIsekai/Expedition/ExpeditionGameMode.cpp b/Source/EmberboundIsekai/Expedition/ExpeditionGameMode.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d900c2cda9ed6c403bee235ca37b9f795a15a932
--- /dev/null
+++ b/Source/EmberboundIsekai/Expedition/ExpeditionGameMode.cpp
@@ -0,0 +1,186 @@
+#include "Expedition/ExpeditionGameMode.h"
+#include "Combat/EmberPlayerCharacter.h"
+#include "Core/EconomySubsystem.h"
+#include "Data/EmberEnemyData.h"
+#include "Enemies/EmberEnemyBase.h"
+#include "Enemies/EnemySpawnerSubsystem.h"
+#include "Expedition/ExpeditionPortal.h"
+#include "UI/EmberHUDWidget.h"
+#include "Camera/PlayerCameraManager.h"
+#include "Kismet/GameplayStatics.h"
+#include "TimerManager.h"
+#include "EmberboundIsekai.h"
+
+AExpeditionGameMode::AExpeditionGameMode()
+{
+	DefaultPawnClass = AEmberPlayerCharacter::StaticClass();
+}
+
+void AExpeditionGameMode::BeginPlay()
+{
+	Super::BeginPlay();
+	BuildRoomSequence();
+	if (APlayerController* PC = UGameplayStatics::GetPlayerController(this, 0))
+	{
+		HUDWidget = CreateWidget<UEmberHUDWidget>(PC, UEmberHUDWidget::StaticClass());
+		if (HUDWidget)
+		{
+			HUDWidget->AddToViewport();
+		}
+	}
+	StartCurrentRoom();
+}
+
+void AExpeditionGameMode::BuildRoomSequence()
+{
+	Rooms.Reset();
+	Rooms.Add({ { TEXT("GreenSlime"), TEXT("BoneRat") }, 2, 0.75f });
+	Rooms.Add({ { TEXT("GreenSlime"), TEXT("RedSlime") }, 3, 0.75f });
+	Rooms.Add({ { TEXT("GoblinStabber"), TEXT("GreenSlime") }, 4, 0.7f });
+	Rooms.Add({ { TEXT("GoblinArcher"), TEXT("RedSlime"), TEXT("BoneRat") }, 5, 0.65f });
+	Rooms.Add({ { TEXT("GoblinStabber"), TEXT("GoblinArcher"), TEXT("BoneRat") }, 6, 0.6f });
+}
+
+void AExpeditionGameMode::StartCurrentRoom()
+{
+	if (!Rooms.IsValidIndex(CurrentRoomIndex))
+	{
+		UE_LOG(LogEmberbound, Log, TEXT("EMBER: RUN COMPLETE"));
+		return;
+	}
+	SpawnedThisRoom = 0;
+	KilledThisRoom = 0;
+	if (HUDWidget)
+	{
+		HUDWidget->SetRoom(CurrentRoomIndex + 1, Rooms.Num());
+	}
+	GetWorldTimerManager().SetTimer(SpawnTimerHandle, this, &AExpeditionGameMode::SpawnWaveEnemy, Rooms[CurrentRoomIndex].SpawnInterval, true, 0.2f);
+	GetWorldTimerManager().SetTimer(RoomCheckTimerHandle, this, &AExpeditionGameMode::CheckRoomClear, 0.5f, true, 1.0f);
+}
+
+void AExpeditionGameMode::SpawnWaveEnemy()
+{
+	if (!Rooms.IsValidIndex(CurrentRoomIndex))
+	{
+		return;
+	}
+	const FEmberRoomWave& Room = Rooms[CurrentRoomIndex];
+	UEnemySpawnerSubsystem* Registry = GetWorld()->GetSubsystem<UEnemySpawnerSubsystem>();
+	if (SpawnedThisRoom >= Room.TotalToSpawn)
+	{
+		GetWorldTimerManager().ClearTimer(SpawnTimerHandle);
+		return;
+	}
+	if (Registry && Registry->GetLiveEnemyCount() >= MaxActiveEnemies)
+	{
+		return;
+	}
+	const FName EnemyName = Room.EnemyAssetNames[SpawnedThisRoom % Room.EnemyAssetNames.Num()];
+	UEmberEnemyData* Data = LoadEnemyData(EnemyName);
+	TSubclassOf<AEmberEnemyBase> EnemyClass = AEmberEnemyBase::StaticClass();
+	if (Data && Data->EnemyClassOverride)
+	{
+		EnemyClass = Data->EnemyClassOverride;
+	}
+	AEmberEnemyBase* Enemy = GetWorld()->SpawnActor<AEmberEnemyBase>(EnemyClass, PickArenaEdgeSpawnLocation(), FRotator::ZeroRotator);
+	if (Enemy)
+	{
+		Enemy->InitFromData(Data);
+		Enemy->OnAcquired_Implementation();
+		++SpawnedThisRoom;
+	}
+}
+
+void AExpeditionGameMode::CheckRoomClear()
+{
+	if (!Rooms.IsValidIndex(CurrentRoomIndex))
+	{
+		GetWorldTimerManager().ClearTimer(RoomCheckTimerHandle);
+		return;
+	}
+	UEnemySpawnerSubsystem* Registry = GetWorld()->GetSubsystem<UEnemySpawnerSubsystem>();
+	if (SpawnedThisRoom >= Rooms[CurrentRoomIndex].TotalToSpawn && (!Registry || Registry->GetLiveEnemyCount() == 0))
+	{
+		CompleteRoom();
+	}
+}
+
+void AExpeditionGameMode::CompleteRoom()
+{
+	GetWorldTimerManager().ClearTimer(SpawnTimerHandle);
+	GetWorldTimerManager().ClearTimer(RoomCheckTimerHandle);
+	GrantRoomReward();
+	UE_LOG(LogEmberbound, Log, TEXT("EMBER: RoomCleared Room=%d"), CurrentRoomIndex + 1);
+	if (CurrentRoomIndex + 1 >= Rooms.Num())
+	{
+		UE_LOG(LogEmberbound, Log, TEXT("EMBER: RUN COMPLETE"));
+		return;
+	}
+	SpawnPortal();
+	FTimerHandle AutoAdvanceHandle;
+	GetWorldTimerManager().SetTimer(AutoAdvanceHandle, this, &AExpeditionGameMode::EnterNextRoom, 1.0f, false);
+}
+
+void AExpeditionGameMode::SpawnPortal()
+{
+	if (CurrentPortal)
+	{
+		CurrentPortal->Destroy();
+	}
+	CurrentPortal = GetWorld()->SpawnActor<AExpeditionPortal>(AExpeditionPortal::StaticClass(), FVector(0.0f, 250.0f, 60.0f), FRotator::ZeroRotator);
+	if (CurrentPortal)
+	{
+		CurrentPortal->OnPortalEntered.BindUObject(this, &AExpeditionGameMode::EnterNextRoom);
+	}
+}
+
+void AExpeditionGameMode::EnterNextRoom()
+{
+	if (APlayerController* PC = UGameplayStatics::GetPlayerController(this, 0))
+	{
+		if (PC->PlayerCameraManager)
+		{
+			PC->PlayerCameraManager->StartCameraFade(0.0f, 1.0f, 0.25f, FLinearColor::Black, false, true);
+			PC->PlayerCameraManager->StartCameraFade(1.0f, 0.0f, 0.25f, FLinearColor::Black, false, false);
+		}
+	}
+	if (CurrentPortal)
+	{
+		CurrentPortal->Destroy();
+		CurrentPortal = nullptr;
+	}
+	++CurrentRoomIndex;
+	StartCurrentRoom();
+}
+
+void AExpeditionGameMode::GrantRoomReward()
+{
+	if (UEconomySubsystem* Economy = GetGameInstance()->GetSubsystem<UEconomySubsystem>())
+	{
+		Economy->Add(EEmberResource::Gold, FMath::RandRange(4, 8));
+		Economy->Add(EEmberResource::Wood, FMath::RandRange(1, 2));
+		Economy->Add(EEmberResource::SoulAsh, 1);
+	}
+}
+
+UEmberEnemyData* AExpeditionGameMode::LoadEnemyData(FName AssetName) const
+{
+	const FString Path = FString::Printf(TEXT("/Game/Emberbound/Data/Enemies/%s.%s"), *AssetName.ToString(), *AssetName.ToString());
+	return LoadObject<UEmberEnemyData>(nullptr, *Path);
+}
+
+FVector AExpeditionGameMode::PickArenaEdgeSpawnLocation() const
+{
+	const float Extent = 760.0f;
+	switch (FMath::RandRange(0, 3))
+	{
+	case 0:
+		return FVector(-Extent, FMath::FRandRange(-Extent, Extent), 80.0f);
+	case 1:
+		return FVector(Extent, FMath::FRandRange(-Extent, Extent), 80.0f);
+	case 2:
+		return FVector(FMath::FRandRange(-Extent, Extent), -Extent, 80.0f);
+	default:
+		return FVector(FMath::FRandRange(-Extent, Extent), Extent, 80.0f);
+	}
+}
diff --git a/Source/EmberboundIsekai/Expedition/ExpeditionGameMode.h b/Source/EmberboundIsekai/Expedition/ExpeditionGameMode.h
new file mode 100644
index 0000000000000000000000000000000000000000..b5ec60f41963fdf24dc7ba886ac92163fa7cd335
--- /dev/null
+++ b/Source/EmberboundIsekai/Expedition/ExpeditionGameMode.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "GameFramework/GameModeBase.h"
+#include "ExpeditionGameMode.generated.h"
+
+class AEmberEnemyBase;
+class AExpeditionPortal;
+class UEmberEnemyData;
+class UEmberHUDWidget;
+
+USTRUCT()
+struct FEmberRoomWave
+{
+	GENERATED_BODY()
+
+	UPROPERTY()
+	TArray<FName> EnemyAssetNames;
+
+	UPROPERTY()
+	int32 TotalToSpawn = 4;
+
+	UPROPERTY()
+	float SpawnInterval = 0.8f;
+};
+
+UCLASS()
+class EMBERBOUNDISEKAI_API AExpeditionGameMode : public AGameModeBase
+{
+	GENERATED_BODY()
+
+public:
+	AExpeditionGameMode();
+
+	virtual void BeginPlay() override;
+
+private:
+	static constexpr int32 MaxActiveEnemies = 24;
+
+	UPROPERTY()
+	TArray<FEmberRoomWave> Rooms;
+
+	UPROPERTY()
+	TObjectPtr<UEmberHUDWidget> HUDWidget;
+
+	UPROPERTY()
+	TObjectPtr<AExpeditionPortal> CurrentPortal;
+
+	int32 CurrentRoomIndex = 0;
+	int32 SpawnedThisRoom = 0;
+	int32 KilledThisRoom = 0;
+	FTimerHandle SpawnTimerHandle;
+	FTimerHandle RoomCheckTimerHandle;
+
+	void BuildRoomSequence();
+	void StartCurrentRoom();
+	void SpawnWaveEnemy();
+	void CheckRoomClear();
+	void CompleteRoom();
+	void SpawnPortal();
+	void EnterNextRoom();
+	void GrantRoomReward();
+	UEmberEnemyData* LoadEnemyData(FName AssetName) const;
+	FVector PickArenaEdgeSpawnLocation() const;
+};
diff --git a/Source/EmberboundIsekai/Expedition/ExpeditionPortal.cpp b/Source/EmberboundIsekai/Expedition/ExpeditionPortal.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e41d74cf7fe8c51ce1a56de5b0ff959ef52bc043
--- /dev/null
+++ b/Source/EmberboundIsekai/Expedition/ExpeditionPortal.cpp
@@ -0,0 +1,34 @@
+#include "Expedition/ExpeditionPortal.h"
+#include "Combat/EmberPlayerCharacter.h"
+#include "Components/SphereComponent.h"
+#include "Components/StaticMeshComponent.h"
+#include "Engine/StaticMesh.h"
+
+AExpeditionPortal::AExpeditionPortal()
+{
+	PrimaryActorTick.bCanEverTick = false;
+	Collision = CreateDefaultSubobject<USphereComponent>(TEXT("Collision"));
+	SetRootComponent(Collision);
+	Collision->InitSphereRadius(90.0f);
+	Collision->SetCollisionProfileName(TEXT("OverlapAllDynamic"));
+	Collision->OnComponentBeginOverlap.AddDynamic(this, &AExpeditionPortal::HandleOverlap);
+
+	Visual = CreateDefaultSubobject<UStaticMeshComponent>(TEXT("Visual"));
+	Visual->SetupAttachment(RootComponent);
+	Visual->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+	static ConstructorHelpers::FObjectFinder<UStaticMesh> CylinderMesh(TEXT("/Engine/BasicShapes/Cylinder.Cylinder"));
+	if (CylinderMesh.Succeeded())
+	{
+		Visual->SetStaticMesh(CylinderMesh.Object);
+		Visual->SetRelativeScale3D(FVector(0.7f, 0.7f, 0.08f));
+	}
+}
+
+void AExpeditionPortal::HandleOverlap(UPrimitiveComponent*, AActor* OtherActor, UPrimitiveComponent*, int32, bool, const FHitResult&)
+{
+	if (!bUsed && OtherActor && OtherActor->IsA<AEmberPlayerCharacter>())
+	{
+		bUsed = true;
+		OnPortalEntered.ExecuteIfBound();
+	}
+}
