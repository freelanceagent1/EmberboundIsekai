+    "/Game/Emberbound/Data/Enemies/GoblinArcher",
+    "/Game/Emberbound/Data/Enemies/BoneRat",
+]
+
+missing = [path for path in required if not unreal.EditorAssetLibrary.does_asset_exist(path)]
