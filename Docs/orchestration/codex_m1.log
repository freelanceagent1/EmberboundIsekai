+
+	UFUNCTION(BlueprintCallable, Category = "Health")
+	void ApplyDamage(float Damage);
+
+	UFUNCTION(BlueprintCallable, Category = "Health")
+	void Heal(float Amount);
+
+	UFUNCTION(BlueprintCallable, Category = "Health")
