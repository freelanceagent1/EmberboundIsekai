@@ -0,0 +1,65 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "GameFramework/GameModeBase.h"
+#include "ExpeditionGameMode.generated.h"
+
+class AEmberEnemyBase;
+class AExpeditionPortal;
+class UEmberEnemyData;
+class UEmberHUDWidget;
+
+USTRUCT()
+struct FEmberRoomWave
+{
+	GENERATED_BODY()
+
+	UPROPERTY()
+	TArray<FName> EnemyAssetNames;
+
+	UPROPERTY()
+	int32 TotalToSpawn = 4;
+
+	UPROPERTY()
+	float SpawnInterval = 0.8f;
+};
+
+UCLASS()
+class EMBERBOUNDISEKAI_API AExpeditionGameMode : public AGameModeBase
+{
+	GENERATED_BODY()
+
+public:
+	AExpeditionGameMode();
+
+	virtual void BeginPlay() override;
+
+private:
+	static constexpr int32 MaxActiveEnemies = 24;
+
+	UPROPERTY()
+	TArray<FEmberRoomWave> Rooms;
+
+	UPROPERTY()
+	TObjectPtr<UEmberHUDWidget> HUDWidget;
+
+	UPROPERTY()
+	TObjectPtr<AExpeditionPortal> CurrentPortal;
+
+	int32 CurrentRoomIndex = 0;
+	int32 SpawnedThisRoom = 0;
+	int32 KilledThisRoom = 0;
+	FTimerHandle SpawnTimerHandle;
+	FTimerHandle RoomCheckTimerHandle;
+
+	void BuildRoomSequence();
+	void StartCurrentRoom();
+	void SpawnWaveEnemy();
+	void CheckRoomClear();
+	void CompleteRoom();
+	void SpawnPortal();
+	void EnterNextRoom();
+	void GrantRoomReward();
+	UEmberEnemyData* LoadEnemyData(FName AssetName) const;
+	FVector PickArenaEdgeSpawnLocation() const;
+};
diff --git a/Source/EmberboundIsekai/Expedition/ExpeditionPortal.cpp b/Source/EmberboundIsekai/Expedition/ExpeditionPortal.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e41d74cf7fe8c51ce1a56de5b0ff959ef52bc043
--- /dev/null
+++ b/Source/EmberboundIsekai/Expedition/ExpeditionPortal.cpp
@@ -0,0 +1,34 @@
+#include "Expedition/ExpeditionPortal.h"
+#include "Combat/EmberPlayerCharacter.h"
+#include "Components/SphereComponent.h"
+#include "Components/StaticMeshComponent.h"
+#include "Engine/StaticMesh.h"
+
+AExpeditionPortal::AExpeditionPortal()
+{
+	PrimaryActorTick.bCanEverTick = false;
+	Collision = CreateDefaultSubobject<USphereComponent>(TEXT("Collision"));
+	SetRootComponent(Collision);
+	Collision->InitSphereRadius(90.0f);
+	Collision->SetCollisionProfileName(TEXT("OverlapAllDynamic"));
+	Collision->OnComponentBeginOverlap.AddDynamic(this, &AExpeditionPortal::HandleOverlap);
+
+	Visual = CreateDefaultSubobject<UStaticMeshComponent>(TEXT("Visual"));
+	Visual->SetupAttachment(RootComponent);
+	Visual->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+	static ConstructorHelpers::FObjectFinder<UStaticMesh> CylinderMesh(TEXT("/Engine/BasicShapes/Cylinder.Cylinder"));
+	if (CylinderMesh.Succeeded())
+	{
+		Visual->SetStaticMesh(CylinderMesh.Object);
+		Visual->SetRelativeScale3D(FVector(0.7f, 0.7f, 0.08f));
+	}
+}
+
+void AExpeditionPortal::HandleOverlap(UPrimitiveComponent*, AActor* OtherActor, UPrimitiveComponent*, int32, bool, const FHitResult&)
+{
+	if (!bUsed && OtherActor && OtherActor->IsA<AEmberPlayerCharacter>())
+	{
+		bUsed = true;
+		OnPortalEntered.ExecuteIfBound();
+	}
+}
diff --git a/Source/EmberboundIsekai/Expedition/ExpeditionPortal.h b/Source/EmberboundIsekai/Expedition/ExpeditionPortal.h
new file mode 100644
index 0000000000000000000000000000000000000000..2263e4888b76534bca6cbc87850512cf8608dcb9
--- /dev/null
+++ b/Source/EmberboundIsekai/Expedition/ExpeditionPortal.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "GameFramework/Actor.h"
+#include "ExpeditionPortal.generated.h"
+
+class USphereComponent;
+class UStaticMeshComponent;
+
+UCLASS()
+class EMBERBOUNDISEKAI_API AExpeditionPortal : public AActor
+{
+	GENERATED_BODY()
+
+public:
+	AExpeditionPortal();
+
+	DECLARE_DELEGATE(FOnPortalEntered);
+	FOnPortalEntered OnPortalEntered;
+
+private:
+	UPROPERTY(VisibleAnywhere)
+	TObjectPtr<USphereComponent> Collision;
+
+	UPROPERTY(VisibleAnywhere)
+	TObjectPtr<UStaticMeshComponent> Visual;
+
+	bool bUsed = false;
+
+	UFUNCTION()
+	void HandleOverlap(UPrimitiveComponent* OverlappedComponent, AActor* OtherActor, UPrimitiveComponent* OtherComp, int32 OtherBodyIndex, bool bFromSweep, const FHitResult& SweepResult);
+};
diff --git a/Source/EmberboundIsekai/UI/EmberHUDWidget.cpp b/Source/EmberboundIsekai/UI/EmberHUDWidget.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..1ca5beda6c9ab9dfca80a382968510983475d281
--- /dev/null
+++ b/Source/EmberboundIsekai/UI/EmberHUDWidget.cpp
@@ -0,0 +1,65 @@
+#include "UI/EmberHUDWidget.h"
+#include "Combat/EmberPlayerCharacter.h"
+#include "Combat/HealthComponent.h"
+#include "Combat/XPComponent.h"
+#include "Core/EconomySubsystem.h"
+#include "Blueprint/WidgetTree.h"
+#include "Components/ProgressBar.h"
+#include "Components/TextBlock.h"
+#include "Components/VerticalBox.h"
+#include "Kismet/GameplayStatics.h"
+
+void UEmberHUDWidget::NativeOnInitialized()
+{
+	Super::NativeOnInitialized();
+	UVerticalBox* Root = WidgetTree->ConstructWidget<UVerticalBox>(UVerticalBox::StaticClass(), TEXT("Root"));
+	WidgetTree->RootWidget = Root;
+
+	HPBar = WidgetTree->ConstructWidget<UProgressBar>(UProgressBar::StaticClass(), TEXT("HPBar"));
+	XPBar = WidgetTree->ConstructWidget<UProgressBar>(UProgressBar::StaticClass(), TEXT("XPBar"));
+	LevelText = WidgetTree->ConstructWidget<UTextBlock>(UTextBlock::StaticClass(), TEXT("LevelText"));
+	RoomText = WidgetTree->ConstructWidget<UTextBlock>(UTextBlock::StaticClass(), TEXT("RoomText"));
+	ResourceText = WidgetTree->ConstructWidget<UTextBlock>(UTextBlock::StaticClass(), TEXT("ResourceText"));
+
+	Root->AddChildToVerticalBox(HPBar);
+	Root->AddChildToVerticalBox(XPBar);
+	Root->AddChildToVerticalBox(LevelText);
+	Root->AddChildToVerticalBox(RoomText);
+	Root->AddChildToVerticalBox(ResourceText);
+}
+
+void UEmberHUDWidget::NativeTick(const FGeometry& MyGeometry, float InDeltaTime)
+{
+	Super::NativeTick(MyGeometry, InDeltaTime);
+	AEmberPlayerCharacter* Player = Cast<AEmberPlayerCharacter>(UGameplayStatics::GetPlayerCharacter(this, 0));
+	if (Player)
+	{
+		if (UHealthComponent* Health = Player->GetHealthComponent())
+		{
+			HPBar->SetPercent(Health->GetMaxHP() > 0.0f ? Health->GetCurrentHP() / Health->GetMaxHP() : 0.0f);
+		}
+		if (UXPComponent* XP = Player->GetXPComponent())
+		{
+			XPBar->SetPercent(XP->GetXPToNext() > 0 ? static_cast<float>(XP->GetXP()) / static_cast<float>(XP->GetXPToNext()) : 0.0f);
+			LevelText->SetText(FText::Format(NSLOCTEXT("EmberHUD", "LevelFmt", "Level {0}"), XP->GetLevel()));
+		}
+	}
+	RoomText->SetText(FText::Format(NSLOCTEXT("EmberHUD", "RoomFmt", "Room {0}/{1}"), CurrentRoom, TotalRooms));
+
+	if (UGameInstance* GameInstance = GetGameInstance())
+	{
+		if (UEconomySubsystem* Economy = GameInstance->GetSubsystem<UEconomySubsystem>())
+		{
+			ResourceText->SetText(FText::Format(NSLOCTEXT("EmberHUD", "ResourcesFmt", "Gold {0}  Wood {1}  Ash {2}"),
+				Economy->Get(EEmberResource::Gold),
+				Economy->Get(EEmberResource::Wood),
+				Economy->Get(EEmberResource::SoulAsh)));
+		}
+	}
+}
+
+void UEmberHUDWidget::SetRoom(int32 Room, int32 MaxRooms)
+{
+	CurrentRoom = Room;
+	TotalRooms = MaxRooms;
+}
