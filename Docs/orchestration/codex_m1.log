new file mode 100644
index 0000000000000000000000000000000000000000..1b5ebfc65cce29142e37e33378d46402074f3d5f
--- /dev/null
+++ b/Source/EmberboundIsekai/Core/Poolable.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "UObject/Interface.h"
+#include "Poolable.generated.h"
+
+UINTERFACE(BlueprintType)
+class UPoolable : public UInterface
+{
+	GENERATED_BODY()
+};
+
+class EMBERBOUNDISEKAI_API IPoolable
+{
+	GENERATED_BODY()
+
+public:
+	UFUNCTION(BlueprintNativeEvent, BlueprintCallable, Category = "Pool")
