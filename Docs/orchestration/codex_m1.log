diff --git a/Source/EmberboundIsekai/Combat/HealthComponent.cpp b/Source/EmberboundIsekai/Combat/HealthComponent.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..12b7f76f243c8cef2d30867272b19e2afb8fa8a3
--- /dev/null
+++ b/Source/EmberboundIsekai/Combat/HealthComponent.cpp
@@ -0,0 +1,87 @@
+#include "Combat/HealthComponent.h"
+#include "Components/MeshComponent.h"
+#include "TimerManager.h"
+
+UHealthComponent::UHealthComponent()
+{
+	PrimaryComponentTick.bCanEverTick = false;
+}
+
+void UHealthComponent::BeginPlay()
+{
+	Super::BeginPlay();
+	CurrentHP = MaxHP;
+	CacheDynamicMaterials();
+}
+
+void UHealthComponent::SetMaxHealth(float NewMaxHealth, bool bHealToFull)
+{
+	MaxHP = FMath::Max(1.0f, NewMaxHealth);
+	if (bHealToFull)
+	{
+		CurrentHP = MaxHP;
+	}
+	else
+	{
+		CurrentHP = FMath::Clamp(CurrentHP, 0.0f, MaxHP);
+	}
+}
+
+void UHealthComponent::ApplyDamage(float Damage)
+{
+	if (Damage <= 0.0f || !IsAlive())
+	{
+		return;
+	}
+	CurrentHP = FMath::Max(0.0f, CurrentHP - Damage);
+	SetFlash(1.0f);
+	if (UWorld* World = GetWorld())
+	{
+		World->GetTimerManager().SetTimer(FlashTimerHandle, FTimerDelegate::CreateUObject(this, &UHealthComponent::SetFlash, 0.0f), 0.08f, false);
+	}
+	OnDamaged.Broadcast(Damage, CurrentHP);
+	if (CurrentHP <= 0.0f)
+	{
+		OnDied.Broadcast(GetOwner());
+	}
+}
+
+void UHealthComponent::Heal(float Amount)
+{
+	if (Amount > 0.0f && IsAlive())
+	{
+		CurrentHP = FMath::Min(MaxHP, CurrentHP + Amount);
+	}
+}
+
+void UHealthComponent::CacheDynamicMaterials()
+{
+	DynamicMaterials.Reset();
+	if (!GetOwner())
+	{
+		return;
+	}
+	TArray<UMeshComponent*> Meshes;
+	GetOwner()->GetComponents<UMeshComponent>(Meshes);
+	for (UMeshComponent* Mesh : Meshes)
+	{
+		for (int32 Index = 0; Index < Mesh->GetNumMaterials(); ++Index)
+		{
+			if (UMaterialInterface* Material = Mesh->GetMaterial(Index))
+			{
+				DynamicMaterials.Add(Mesh->CreateDynamicMaterialInstance(Index, Material));
+			}
+		}
+	}
+}
+
+void UHealthComponent::SetFlash(float Value)
+{
+	for (UMaterialInstanceDynamic* Material : DynamicMaterials)
+	{
+		if (Material)
+		{
+			Material->SetScalarParameterValue(TEXT("Flash"), Value);
+		}
+	}
+}
diff --git a/Source/EmberboundIsekai/Combat/HealthComponent.h b/Source/EmberboundIsekai/Combat/HealthComponent.h
new file mode 100644
index 0000000000000000000000000000000000000000..2da8a8a5b4ed0eafc84c7675c97c51e818efd23c
--- /dev/null
+++ b/Source/EmberboundIsekai/Combat/HealthComponent.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Components/ActorComponent.h"
+#include "HealthComponent.generated.h"
+
+DECLARE_DYNAMIC_MULTICAST_DELEGATE_OneParam(FOnHealthDied, AActor*, DeadActor);
+DECLARE_DYNAMIC_MULTICAST_DELEGATE_TwoParams(FOnHealthDamaged, float, Damage, float, CurrentHP);
+
+UCLASS(ClassGroup = (Combat), meta = (BlueprintSpawnableComponent))
+class EMBERBOUNDISEKAI_API UHealthComponent : public UActorComponent
+{
+	GENERATED_BODY()
+
+public:
+	UHealthComponent();
+
+	virtual void BeginPlay() override;
+
+	UFUNCTION(BlueprintCallable, Category = "Health")
+	void SetMaxHealth(float NewMaxHealth, bool bHealToFull);
+
+	UFUNCTION(BlueprintCallable, Category = "Health")
+	void ApplyDamage(float Damage);
+
+	UFUNCTION(BlueprintCallable, Category = "Health")
+	void Heal(float Amount);
+
+	UFUNCTION(BlueprintCallable, Category = "Health")
+	bool IsAlive() const { return CurrentHP > 0.0f; }
+
+	UFUNCTION(BlueprintCallable, Category = "Health")
+	float GetCurrentHP() const { return CurrentHP; }
+
+	UFUNCTION(BlueprintCallable, Category = "Health")
+	float GetMaxHP() const { return MaxHP; }
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Health")
+	float MaxHP = 100.0f;
+
+	UPROPERTY(BlueprintAssignable, Category = "Health")
+	FOnHealthDied OnDied;
+
+	UPROPERTY(BlueprintAssignable, Category = "Health")
+	FOnHealthDamaged OnDamaged;
+
+private:
+	UPROPERTY()
+	float CurrentHP = 100.0f;
+
+	UPROPERTY()
+	TArray<TObjectPtr<UMaterialInstanceDynamic>> DynamicMaterials;
+
+	FTimerHandle FlashTimerHandle;
+
+	void CacheDynamicMaterials();
+	void SetFlash(float Value);
+};
diff --git a/Source/EmberboundIsekai/Combat/LootDropComponent.cpp b/Source/EmberboundIsekai/Combat/LootDropComponent.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9fdd054874f4a2e96004a5f8beb76bc25bc0c6b8
--- /dev/null
+++ b/Source/EmberboundIsekai/Combat/LootDropComponent.cpp
@@ -0,0 +1,54 @@
+#include "Combat/LootDropComponent.h"
+#include "Combat/EmberPickup.h"
+#include "Core/ObjectPoolSubsystem.h"
+#include "Data/EmberEnemyData.h"
+
+ULootDropComponent::ULootDropComponent()
+{
+	PrimaryComponentTick.bCanEverTick = false;
+}
+
+void ULootDropComponent::SetEnemyData(UEmberEnemyData* InEnemyData)
+{
+	EnemyData = InEnemyData;
+}
+
+void ULootDropComponent::HandleOwnerDied(AActor* DeadActor)
+{
+	if (!EnemyData || !DeadActor || !GetWorld())
+	{
+		return;
+	}
+	UObjectPoolSubsystem* Pool = GetWorld()->GetSubsystem<UObjectPoolSubsystem>();
+	if (!Pool)
+	{
+		return;
+	}
+
+	const FVector BaseLocation = DeadActor->GetActorLocation();
+	if (AEmberPickup* XP = Pool->Acquire<AEmberPickup>(AEmberPickup::StaticClass(), FTransform(BaseLocation + FVector(0.0f, 0.0f, 35.0f))))
+	{
+		XP->Configure(EEmberPickupType::XP, EnemyData->XPReward);
+	}
+
+	for (const FEnemyResourceDrop& Drop : EnemyData->ResourceDrops)
+	{
+		if (FMath::FRand() <= Drop.Probability)
+		{
+			const int32 Amount = FMath::RandRange(Drop.MinAmount, FMath::Max(Drop.MinAmount, Drop.MaxAmount));
+			EEmberPickupType Type = EEmberPickupType::Gold;
+			if (Drop.Resource == EEmberResource::Wood)
+			{
+				Type = EEmberPickupType::Wood;
+			}
+			else if (Drop.Resource == EEmberResource::SoulAsh)
+			{
+				Type = EEmberPickupType::SoulAsh;
+			}
+			if (AEmberPickup* Pickup = Pool->Acquire<AEmberPickup>(AEmberPickup::StaticClass(), FTransform(BaseLocation + FMath::VRand() * 60.0f)))
+			{
+				Pickup->Configure(Type, Amount);
+			}
+		}
+	}
+}
