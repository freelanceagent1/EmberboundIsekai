+#pragma once
+
+#include "CoreMinimal.h"
+#include "GameFramework/GameModeBase.h"
+#include "ExpeditionGameMode.generated.h"
+
+class AEmberEnemyBase;
+class AExpeditionPortal;
+class UEmberEnemyData;
+class UEmberHUDWidget;
+
+USTRUCT()
+struct FEmberRoomWave
+{
+	GENERATED_BODY()
+
+	UPROPERTY()
+	TArray<FName> EnemyAssetNames;
+
+	UPROPERTY()
+	int32 TotalToSpawn = 4;
+
+	UPROPERTY()
+	float SpawnInterval = 0.8f;
+};
+
+UCLASS()
+class EMBERBOUNDISEKAI_API AExpeditionGameMode : public AGameModeBase
+{
+	GENERATED_BODY()
+
+public:
+	AExpeditionGameMode();
+
+	virtual void BeginPlay() override;
+
+private:
+	static constexpr int32 MaxActiveEnemies = 24;
+
+	UPROPERTY()
+	TArray<FEmberRoomWave> Rooms;
+
+	UPROPERTY()
+	TObjectPtr<UEmberHUDWidget> HUDWidget;
+
+	UPROPERTY()
+	TObjectPtr<AExpeditionPortal> CurrentPortal;
+
+	int32 CurrentRoomIndex = 0;
+	int32 SpawnedThisRoom = 0;
+	int32 KilledThisRoom = 0;
+	FTimerHandle SpawnTimerHandle;
+	FTimerHandle RoomCheckTimerHandle;
+
+	void BuildRoomSequence();
+	void StartCurrentRoom();
+	void SpawnWaveEnemy();
+	void CheckRoomClear();
+	void CompleteRoom();
+	void SpawnPortal();
+	void EnterNextRoom();
+	void GrantRoomReward();
+	UEmberEnemyData* LoadEnemyData(FName AssetName) const;
+	FVector PickArenaEdgeSpawnLocation() const;
+};
diff --git a/Source/EmberboundIsekai/Expedition/ExpeditionPortal.cpp b/Source/EmberboundIsekai/Expedition/ExpeditionPortal.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e41d74cf7fe8c51ce1a56de5b0ff959ef52bc043
--- /dev/null
+++ b/Source/EmberboundIsekai/Expedition/ExpeditionPortal.cpp
@@ -0,0 +1,34 @@
+#include "Expedition/ExpeditionPortal.h"
+#include "Combat/EmberPlayerCharacter.h"
+#include "Components/SphereComponent.h"
+#include "Components/StaticMeshComponent.h"
+#include "Engine/StaticMesh.h"
+
+AExpeditionPortal::AExpeditionPortal()
+{
+	PrimaryActorTick.bCanEverTick = false;
+	Collision = CreateDefaultSubobject<USphereComponent>(TEXT("Collision"));
+	SetRootComponent(Collision);
+	Collision->InitSphereRadius(90.0f);
+	Collision->SetCollisionProfileName(TEXT("OverlapAllDynamic"));
+	Collision->OnComponentBeginOverlap.AddDynamic(this, &AExpeditionPortal::HandleOverlap);
+
+	Visual = CreateDefaultSubobject<UStaticMeshComponent>(TEXT("Visual"));
+	Visual->SetupAttachment(RootComponent);
+	Visual->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+	static ConstructorHelpers::FObjectFinder<UStaticMesh> CylinderMesh(TEXT("/Engine/BasicShapes/Cylinder.Cylinder"));
+	if (CylinderMesh.Succeeded())
+	{
+		Visual->SetStaticMesh(CylinderMesh.Object);
+		Visual->SetRelativeScale3D(FVector(0.7f, 0.7f, 0.08f));
+	}
+}
+
+void AExpeditionPortal::HandleOverlap(UPrimitiveComponent*, AActor* OtherActor, UPrimitiveComponent*, int32, bool, const FHitResult&)
+{
+	if (!bUsed && OtherActor && OtherActor->IsA<AEmberPlayerCharacter>())
+	{
+		bUsed = true;
+		OnPortalEntered.ExecuteIfBound();
+	}
+}
